<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/img_graphic"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@string/app_name" />

    <!-- Prev Button (<) : Left side of landscape = top edge of portrait -->
    <Button
        android:id="@+id/btn_prev"
        android:layout_width="80dp"
        android:layout_height="180dp"
        android:layout_gravity="top|end"
        android:background="#00000000" />

    <!-- Next Button (>) : Right side of landscape = bottom edge of portrait -->
    <Button
        android:id="@+id/btn_next"
        android:layout_width="80dp"
        android:layout_height="180dp"
        android:layout_gravity="bottom|end"
        android:background="#00000000" />

    <!-- Pan Left (<) at visual bottom-left -> physical top-start -->
    <Button
        android:id="@+id/btn_pan_left"
        android:layout_width="90dp"
        android:layout_height="140dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="0dp"
        android:background="#01000000" />

    <!-- Pan Right (>) at visual bottom-right -> physical bottom-start -->
    <Button
        android:id="@+id/btn_pan_right"
        android:layout_width="90dp"
        android:layout_height="140dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="0dp"
        android:background="#01000000" />

    <!-- Zoom buttons: Left side of landscape = top edge of portrait -->
    <!-- We put them in the middle of the top edge. 
         First element (left in portrait) = bottom in landscape = "-"
         Second element (right in portrait) = top in landscape = "+"
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:layout_gravity="top"
        android:gravity="center_horizontal|top"
        android:layout_marginTop="16dp"
        android:padding="8dp">

        <Button
            android:id="@+id/btn_zoom_out"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="-"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:rotation="90"
            android:background="#88333333"
            android:layout_marginEnd="16dp" />

        <Button
            android:id="@+id/btn_zoom_in"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:rotation="90"
            android:background="#88333333" />
    </LinearLayout>
</FrameLayout>
