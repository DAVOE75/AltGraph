<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/img_graphic"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@string/app_name" />

    <!-- Prev Climb Button (<) : Visual Left side of landscape header = physical top-end -->
    <Button
        android:id="@+id/btn_prev"
        android:layout_width="150dp"
        android:layout_height="120dp"
        android:layout_gravity="top|end"
        android:background="#00000000" />

    <!-- Next Climb Button (>) : Visual Right side of landscape header = physical bottom-end -->
    <Button
        android:id="@+id/btn_next"
        android:layout_width="150dp"
        android:layout_height="120dp"
        android:layout_gravity="bottom|end"
        android:background="#00000000" />

    <!-- Pan Left (<) : Physical top-start -->
    <Button
        android:id="@+id/btn_pan_left"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="top|start"
        android:background="#01000000" />

    <!-- Pan Right (>) : Physical bottom-start -->
    <Button
        android:id="@+id/btn_pan_right"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="bottom|start"
        android:background="#01000000" />

    <!-- Zoom buttons: Visual Right side of landscape = physical bottom-center -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:padding="4dp">

        <Button
            android:id="@+id/btn_zoom_in"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:rotation="90"
            android:background="#88333333"
            android:layout_marginEnd="16dp" />

        <Button
            android:id="@+id/btn_zoom_out"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="-"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:rotation="90"
            android:background="#88333333" />
    </LinearLayout>
</FrameLayout>
