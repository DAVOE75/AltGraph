<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/img_graphic"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@string/app_name" />

    <!-- Prev Climb Button (<) : Visual Left side of landscape header = physical top-end -->
    <Button
        android:id="@+id/btn_prev"
        android:layout_width="80dp"
        android:layout_height="90dp"
        android:layout_gravity="top|end"
        android:stateListAnimator="@null"
        android:background="#01000000" />

    <!-- Next Climb Button (>) : Visual Right side of landscape header = physical bottom-end -->
    <Button
        android:id="@+id/btn_next"
        android:layout_width="80dp"
        android:layout_height="90dp"
        android:layout_gravity="bottom|end"
        android:stateListAnimator="@null"
        android:background="#01000000" />

    <!-- Pan Left (<) : Physical top-start -->
    <Button
        android:id="@+id/btn_pan_left"
        android:layout_width="@dimen/pan_btn_size"
        android:layout_height="@dimen/pan_btn_size"
        android:layout_gravity="top|start"
        android:layout_marginTop="2dp"
        android:stateListAnimator="@null"
        android:background="#01000000" />

    <!-- Pan Right (>) : Physical bottom-start -->
    <Button
        android:id="@+id/btn_pan_right"
        android:layout_width="@dimen/pan_btn_size"
        android:layout_height="@dimen/pan_btn_size"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="2dp"
        android:stateListAnimator="@null"
        android:background="#01000000" />

    <!-- Zoom controls (A la izquierda del todo y arriba en apaisado: physical top|end, con + visualmente arriba y - abajo) -->
    <LinearLayout
        android:id="@+id/zoom_controls_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:gravity="center">

        <Button
            android:id="@+id/btn_zoom_out"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="-"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:rotation="90"
            android:background="#CC1E293B"
            android:layout_marginEnd="10dp" />

        <Button
            android:id="@+id/btn_zoom_in"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:rotation="90"
            android:background="#CC1E293B" />
    </LinearLayout>

    <!-- Alias / Top controls configurados idénticos en la misma posición visual izquierda arriba -->
    <LinearLayout
        android:id="@+id/zoom_controls_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:gravity="center">

        <Button
            android:id="@+id/btn_zoom_out_top"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="-"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:rotation="90"
            android:background="#CC1E293B"
            android:layout_marginEnd="10dp" />

        <Button
            android:id="@+id/btn_zoom_in_top"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:rotation="90"
            android:background="#CC1E293B" />
    </LinearLayout>
</FrameLayout>
