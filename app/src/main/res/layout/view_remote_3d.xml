<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/img_graphic"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@string/app_name" />

    <FrameLayout
        android:id="@+id/btn_toggle_compass"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="15dp"
        android:background="#00000000" />

    <FrameLayout
        android:id="@+id/btn_toggle_compass_land"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="15dp"
        android:layout_marginEnd="15dp"
        android:background="#00000000" />

    <Button
        android:id="@+id/btn_pan_left"
        android:layout_width="@dimen/pan_btn_size"
        android:layout_height="@dimen/pan_btn_size"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="2dp"
        android:stateListAnimator="@null"
        android:background="#01000000" />

    <Button
        android:id="@+id/btn_pan_right"
        android:layout_width="@dimen/pan_btn_size"
        android:layout_height="@dimen/pan_btn_size"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="2dp"
        android:stateListAnimator="@null"
        android:background="#01000000" />

    <Button
        android:id="@+id/btn_pan_left_top"
        android:layout_width="@dimen/pan_btn_size"
        android:layout_height="@dimen/pan_btn_size"
        android:layout_gravity="top|start"
        android:layout_marginStart="2dp"
        android:visibility="gone"
        android:stateListAnimator="@null"
        android:background="#01000000" />

    <Button
        android:id="@+id/btn_pan_right_top"
        android:layout_width="@dimen/pan_btn_size"
        android:layout_height="@dimen/pan_btn_size"
        android:layout_gravity="top|end"
        android:layout_marginEnd="2dp"
        android:visibility="gone"
        android:stateListAnimator="@null"
        android:background="#01000000" />

    <!-- Controles de Zoom en el lateral (posición estándar cuando el encabezado está activo) -->
    <LinearLayout
        android:id="@+id/zoom_controls_side"
        android:layout_width="64dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_gravity="start"
        android:gravity="center_vertical|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="55dp"
        android:padding="8dp">

        <Button
            android:id="@+id/btn_zoom_in"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:background="#88333333"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btn_zoom_out"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="-"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:background="#88333333" />
    </LinearLayout>

    <!-- Controles de Zoom centrados en el espacio libre superior (uno al lado del otro: + y -) -->
    <LinearLayout
        android:id="@+id/zoom_controls_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_zoom_in_top"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:background="#88333333"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/btn_zoom_out_top"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="-"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:background="#88333333" />
    </LinearLayout>

</FrameLayout>