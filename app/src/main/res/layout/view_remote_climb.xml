<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/img_graphic"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@string/app_name" />

    <!-- Prev Button -->
    <Button
        android:id="@+id/btn_prev"
        android:layout_width="120dp"
        android:layout_height="70dp"
        android:layout_gravity="top|start"
        android:background="#01000000" />

    <!-- Next Button -->
    <Button
        android:id="@+id/btn_next"
        android:layout_width="120dp"
        android:layout_height="70dp"
        android:layout_gravity="top|end"
        android:background="#01000000" />

    <!-- Pan Left (<) at bottom-left -->
    <Button
        android:id="@+id/btn_pan_left"
        android:layout_width="140dp"
        android:layout_height="90dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="0dp"
        android:background="#01000000" />

    <!-- Pan Right (>) at bottom-end -->
    <Button
        android:id="@+id/btn_pan_right"
        android:layout_width="140dp"
        android:layout_height="90dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="0dp"
        android:background="#01000000" />

    <!-- Zoom controls TOP (Header position) -->
    <LinearLayout
        android:id="@+id/zoom_controls_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="top|end"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="12dp"
        android:gravity="center">

        <Button
            android:id="@+id/btn_zoom_out_top"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="-"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:background="#CC1E293B"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_zoom_in_top"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:background="#CC1E293B" />
    </LinearLayout>

    <!-- Zoom controls BOTTOM (Side position) -->
    <LinearLayout
        android:id="@+id/zoom_controls_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="16dp"
        android:gravity="center">

        <Button
            android:id="@+id/btn_zoom_in"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:background="#CC1E293B"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_zoom_out"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:text="-"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:background="#CC1E293B" />
    </LinearLayout>
</FrameLayout>
